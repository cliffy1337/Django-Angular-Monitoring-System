# ============================================================
# Copy this file to .env, then run:
#
#   docker compose up --build          ← local demo
#   docker compose -f docker-compose.prod.yml up --build  ← production
#
# For the local demo you do not need to edit anything below.
# For production, replace every placeholder value.
# ============================================================


# =========================
# Django Core
# =========================
# DJANGO_SETTINGS_MODULE is set per compose file — do not set it here.
SECRET_KEY=docker-demo-insecure-key-replace-before-real-deployment-abc123xyz

# Required by prod.py only; docker.py hardcodes localhost.
ALLOWED_HOSTS=localhost,127.0.0.1


# =========================
# Database (PostgreSQL)
# =========================
# POSTGRES_* initialise the postgres container image.
# DB_*      are used by Django to connect (values must match above).
POSTGRES_DB=vigil_db
POSTGRES_USER=vigil_user
POSTGRES_PASSWORD=vigil_pass

DB_NAME=vigil_db
DB_USER=vigil_user
DB_PASSWORD=vigil_pass
DB_HOST=db
DB_PORT=5432


# =========================
# Redis (Celery broker)
# =========================
REDIS_URL=redis://redis:6379/0


# =========================
# Email SMTP (production only)
# =========================
# docker-compose.yml uses the console email backend — emails appear in
# "docker logs vigil-backend-1" and no SMTP credentials are required.
#
# Uncomment and fill these in only when using docker-compose.prod.yml.
#
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-smtp-password
# DEFAULT_FROM_EMAIL=Vigil Monitor <no-reply@example.com>


# =========================
# CORS (production only)
# =========================
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
