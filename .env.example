# =========================
# Django Core
# =========================
# Use config.settings.prod for docker-compose.prod.yml (overridden there automatically)
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-with-a-50-char-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com


# =========================
# Database (PostgreSQL)
# =========================
# POSTGRES_* are read by the postgres container image
POSTGRES_DB=vigil_db
POSTGRES_USER=vigil_user
POSTGRES_PASSWORD=replace-with-password

# DB_* are read by Django settings (must match POSTGRES_* values above)
DB_NAME=vigil_db
DB_USER=vigil_user
DB_PASSWORD=replace-with-password
DB_HOST=db
DB_PORT=5432


# =========================
# Redis (Celery broker)
# =========================
REDIS_URL=redis://redis:6379/0


# =========================
# CORS (production only)
# =========================
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://yourdomain.com,https://yourdomain.com


# =========================
# Email SMTP
# =========================
EMAIL_HOST=your-smtp-host.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Vigil Monitor <no-reply@domain.com>


# =========================
# Optional: SendGrid
# =========================
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-key
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@domain.com